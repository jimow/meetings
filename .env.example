# Copy to .env and adjust for your deployment. All values are optional.

# Port to listen on
PORT=3000

# Public origin used to build QR codes / shareable links.
# LEAVE UNSET to auto-derive from the domain each request arrives on
# (localhost when run locally, your real domain when deployed behind a proxy).
# Only set this to pin a fixed canonical origin, e.g. https://signin.mandera.go.ke
# BASE_URL=https://signin.mandera.go.ke

# Set to "production" when deploying
NODE_ENV=development

# Force the Secure flag on cookies (use when TLS is terminated by an upstream proxy)
FORCE_SECURE_COOKIES=false

# Admin session lifetime in hours
SESSION_TTL_HOURS=12

# If true, anyone can register an admin account at any time (NOT recommended).
# Default: only the very first admin can self-register; after that an existing
# admin must create new ones.
ALLOW_OPEN_REGISTRATION=false

# Largest geofence radius (meters) an admin may configure
MAX_RADIUS_METERS=50000

# Default max GPS accuracy (meters) before a sign-in is rejected
DEFAULT_MAX_ACCURACY_METERS=100

# Override the auto-generated session signing secret (otherwise persisted in data/secrets.json)
# SESSION_SECRET=replace-with-a-long-random-string

# =====================================================================
# Data backend — Supabase (required; SQLite has been removed)
# =====================================================================
# Run supabase/schema.sql in your project first.
# Use the SERVICE ROLE key (server-side only — never expose to the browser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================================
# Email notifications — Resend (https://resend.com)
# =====================================================================
# Both must be set for email to send. The "from" must be on a verified domain.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="County Government of Mandera <noreply@mandera.go.ke>"

# Where website contact-form messages are delivered
# CONTACT_TO=info@mandera.go.ke

# =====================================================================
# SMS notifications — Africa's Talking (https://africastalking.com)
# =====================================================================
# Use username "sandbox" + a sandbox key for testing (routes to the sandbox API).
# AT_USERNAME=sandbox
# AT_API_KEY=atsk_xxxxxxxx
# Optional registered sender ID / short code (production only)
# AT_SENDER_ID=MANDERA

# =====================================================================
# Default organization branding seeded for the first admin
# =====================================================================
# ORG_NAME=County Government of Mandera
# ORG_ADDRESS=P.O. Box 13-70300, Mandera, Kenya
# ORG_CONTACT=info@mandera.go.ke
# ORG_FOOTER=County Government of Mandera · Official attendance record
